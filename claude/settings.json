{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(jj commit:*)",
      "Bash(jj describe:*)",
      "Bash(jj edit:*)",
      "Bash(jj file:*)",
      "Bash(jj log:*)",
      "Bash(jj new:*)",
      "Bash(jj show:*)",
      "Bash(jj st:*)",
      "Bash(just:*)",
      "Bash(nix:*)",
      "Bash(bat:*)",
      "Bash(deadnix:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(nixfmt:*)",
      "Bash(pre-commit:*)",
      "Bash(sed:*)",
      "Bash(shellcheck:*)",
      "Bash(shuf:*)",
      "Bash(statix:*)",
      "Bash(stylua:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(xxd:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:nix-community.github.io)",
      "WebFetch(domain:mynixos.com)",
      "WebFetch(domain:docs.claude.com)"
    ],
    "deny": ["Read(./.env)"],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/deny-git-if-colocated.pl"
          }
        ]
      }
    ]
  },
  "promptSuggestionEnabled": false,
  "tui": "default",
  "editorMode": "vim"
}
